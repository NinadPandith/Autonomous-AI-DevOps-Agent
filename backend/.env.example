# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
DATABASE_PATH=codesentinel.db
MAX_FIX_ATTEMPTS=3
CLAUDE_EFFORT=high
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# "Paste Your Own Repo": set to true to let the agent clone, install and run tests of a pasted
# GitHub repo ON THIS MACHINE. That executes the repo's code — only enable it for repos you trust.
ALLOW_USER_REPOS=false
